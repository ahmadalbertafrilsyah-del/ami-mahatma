
# ---- Identitas penyelenggara (opsional) ------------------------------------
# Muncul pada kop laporan PDF dan pengirim email. Kosong = memakai APP_NAME.
NEXT_PUBLIC_ORG_NAME=
# Dipakai untuk metadata tautan; isi dengan domain produksi saat deploy.
NEXT_PUBLIC_SITE_URL=

# ---- Email (SMTP) ----------------------------------------------------------
# Dipakai mengirim laporan audit beserta lampiran PDF ke kepala sekolah.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS diisi App Password
# (bukan kata sandi akun) dari myaccount.google.com/apppasswords.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alamat pengirim yang tampil di kotak masuk penerima. Kosong = memakai SMTP_USER.
SMTP_FROM=
